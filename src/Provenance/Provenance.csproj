<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Provenance</RootNamespace>
    <PackageId>Provenance</PackageId>
    <Description>Deterministic prompt-injection defence for .NET agents built on Microsoft.Extensions.AI: information-flow labels, sink policies, and quarantined processing of untrusted content.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="$(MicrosoftExtensionsAIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Provenance.Tests" />
  </ItemGroup>

</Project>
