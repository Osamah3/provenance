<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Provenance</RootNamespace>
    <PackageId>Provenance</PackageId>
    <Description>Deterministic prompt-injection defence for .NET agents built on Microsoft.Extensions.AI: information-flow labels, sink policies, and quarantined processing of untrusted content.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <Version>0.3.0-alpha.1</Version>
    <PackageTags>ai;agents;llm;security;prompt-injection;information-flow-control;mcp;microsoft-extensions-ai</PackageTags>
    <PackageProjectUrl>https://github.com/Osamah3/provenance</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="$(MicrosoftExtensionsAIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Provenance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
